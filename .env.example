# Copy to .env and fill in. Never commit .env.
MODYX_ENV=development            # "production" on the server
SECRET_KEY=                      # required in production: python -c "import secrets; print(secrets.token_hex(32))"
BASE_URL=                        # required in production, e.g. https://panel.example.com
COOKIE_SECURE=                   # defaults to true in production; set false ONLY for a first test over plain http
ALLOW_REGISTRATION=false         # first account becomes the owner; later sign-ups stay closed unless true
ADMIN_EMAILS=shtah5444@gmail.com                    # optional: extra emails that become admin when they register
DATABASE_PATH=instance/modyx.db
STORAGE_ROOT=data/storage
DEFAULT_LANG=ar

# E-mail (verification + password reset). Empty SMTP_HOST in development: links go to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=MODYX VPS HOSTING <no-reply@example.com>
REQUIRE_VERIFIED=                # defaults to true when SMTP is configured
